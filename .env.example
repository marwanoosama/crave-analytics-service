PORT=5000
ASPNETCORE_ENVIRONMENT=development

# MUST match core-service / order-service ACCESS_SECRET (JWT HS256)
# .NET enforces the HS256 256-bit minimum: the secret must be >= 32 bytes.
ACCESS_SECRET=crave-dev-shared-access-secret-0001

CORS_ORIGINS=http://localhost:3000

# MongoDB
MONGO_URL=mongodb://localhost:27017
MONGO_DATABASE=crave_analytics

# RabbitMQ (inbound order events — consumer only, never publishes)
RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_ORDER_EVENTS_EXCHANGE=order.events
RABBITMQ_ORDER_EVENTS_QUEUE=analytics-service.order-events
RABBITMQ_ORDER_EVENTS_BINDINGS="order.#,payment.#"
RABBITMQ_ORDER_EVENTS_DLX=order.events.dlx
RABBITMQ_ORDER_EVENTS_DLQ=analytics-service.order-events.dlq
RABBITMQ_PREFETCH=32

# core-service (RBAC permission lookups — GET /api/internal/rbac/permissions?role=)
CORE_SERVICE_BASE_URL=http://localhost:3000
CORE_INTERNAL_API_KEY=change-me

# RBAC permission cache
RBAC_CACHE_TTL_SEC=300

# event dedupe window (event_ids TTL, days)
EVENT_DEDUPE_TTL_DAYS=7
